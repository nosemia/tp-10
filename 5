#include<iostream>
using namespace std;

class Persona {
private:
    string nombre;
    int edad;
public:
    void cargarDatos() {
        cout << "Nombre: ";
        cin >> nombre;
        cout << "Edad: ";
        cin >> edad;
    }
    void imprimirDatos() {
        cout << "Nombre: " << nombre << endl;
        cout << "Edad: " << edad << endl;
    }
};

class Empleado : public Persona {
private:
    float sueldo;
public:
    void cargarSueldo() {
        cout << "Sueldo: ";
        cin >> sueldo;
    }
    void imprimirSueldo() {
        cout << "Sueldo: " << sueldo << endl;
    }
};

int main() {
    Persona p1;
    cout << "--- Persona ---" << endl;
    p1.cargarDatos();
    p1.imprimirDatos();

    Empleado e1;
    cout << "\n--- Empleado ---" << endl;
    e1.cargarDatos(); 
    e1.cargarSueldo();  
    e1.imprimirDatos(); 
    e1.imprimirSueldo();
    return 0;
}
